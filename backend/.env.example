# Example runtime config for the aiops-engine backend.
# Copy to .env and fill in values for your environment:
#
#   cp backend/.env.example backend/.env
#
# Read automatically by pydantic Settings (app/core/config.py -> Config.env_file).
# Every key here is optional — app/core/config.py defines a default for each.
# The real .env is gitignored because it contains internal cluster addressing.

# Database. The container default is /data/aiops.db; point this at a local path
# when running outside Kubernetes. Swap to postgresql+asyncpg://... for HA.
DATABASE_URL=sqlite+aiosqlite:////data/aiops.db

# TLS verification for outbound HTTP (Prometheus / Alertmanager / sources).
# Set false only for self-signed or internal-CA endpoints. In production,
# prefer mounting the internal CA bundle and leaving this true.
VERIFY_TLS=true

# Ollama. In-cluster this is the Service DNS name; if you target a ClusterIP
# directly, note it can change when the Service is recreated — re-check with
#   kubectl get svc <ollama-svc> -n <namespace> -o jsonpath='{.spec.clusterIP}'
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
# Investigative RCA emits a large structured JSON; CPU-only generation can run
# several minutes, so the read timeout must be generous.
OLLAMA_TIMEOUT=360

# Alertmanager base URL (in-cluster Service, or an external ingress).
ALERTMANAGER_URL=http://alertmanager-operated:9093

# Prometheus is normally configured via the Sources UI (persisted in the DB).
# The scraper falls back to PROMETHEUS_URL only when no source is configured.
#PROMETHEUS_URL=http://prometheus-operated:9090

# Change this before any non-local deployment.
#SECRET_KEY=change-me-in-production
